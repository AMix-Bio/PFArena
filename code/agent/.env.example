# Copy to .env (never commit .env) and export these variables in your shell.
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://api.openai.com/v1
CLAUDE_API_KEY=replace_with_your_key
# Claude must use an OpenAI-compatible gateway; do not put a raw Anthropic URL here.
CLAUDE_BASE_URL=https://your-claude-compatible-gateway.example/v1
BIOMNI_PROJECT_ROOT=/path/to/your/biomni/project
